rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ai cũng xem được tỉ số, lịch, xếp hạng và bốc thăm.
    // Chỉ trọng tài đã đăng nhập mới được ghi.
    match /matches/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /meta/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
